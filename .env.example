# TradeFlow Sales Coach — environment template.
# Copy to .env and fill in. NEVER commit .env. NEVER ship these into the client bundle.

# ── Reasoning model ────────────────────────────────────────────────────────────
# Which LLMProvider implementation to use: openrouter_nemotron | openai_compatible | mock
LLM_PROVIDER=openrouter_nemotron
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Free evaluation route. Rate-limited (~20 RPM / ~200 RPD) and logged upstream:
# do NOT send real prospect audio or confidential call content through a :free model.
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Latency fallback candidate (smaller sibling, still free).
LLM_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Reasoning models: lower effort = lower latency. Test 'none'/'low' first. (OpenRouter: reasoning.effort)
LLM_REASONING_EFFORT=low
LLM_MAX_TOKENS=220
LLM_TIMEOUT_S=12
LLM_MAX_RETRIES=2
# Optional attribution headers OpenRouter uses for app ranking.
OPENROUTER_APP_URL=
OPENROUTER_APP_TITLE=TradeFlow Sales Coach

# ── Speech-to-text ─────────────────────────────────────────────────────────────
# Which STTProvider implementation to use: deepgram | groq_whisper | mock
STT_PROVIDER=deepgram
# Must be a Member-role key or higher: the /v1/auth/grant token endpoint rejects default-role keys.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# Lifetime of the ephemeral token handed to the browser. The socket stays open after it expires.
DEEPGRAM_TOKEN_TTL_S=120
# Groq is an evaluated alternative for recorded-audio transcription, not a v0 requirement.
GROQ_API_KEY=

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=8000
# Comma-separated origins allowed to call the backend. Same-origin PWA needs none.
ALLOWED_ORIGINS=
# Free-tier request budget guarding: requests per session, then warn.
RATE_LIMIT_PER_SESSION=120
RATE_LIMIT_PER_DAY=200

# ── Dev / privacy ──────────────────────────────────────────────────────────────
# Provider reachability is restricted in some dev sandboxes; mock keeps the UI usable.
# 1 = never call any external provider (canned responses + deterministic tests).
DEMO_MODE=0
# 1 = persist transcripts to ./data for debugging. OFF by default; never enable on real calls.
STORE_TRANSCRIPTS=0
LOG_LEVEL=INFO
